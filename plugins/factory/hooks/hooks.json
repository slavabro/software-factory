{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}\" python3 -m skillcheck --hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$FACTORY_RUN\" ] || exit 0; PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}\" python3 -m sfactory.guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
